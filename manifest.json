{
  "manifest_version": 3,
  "name": "Queued for ChatGPT",
  "short_name": "Queued for ChatGPT",
  "version": "1.2.6",
  "description": "Lightweight ChatGPT queues with saved workflows, Project support, live dock status, expandable workflows, prompt Copy and recent activity and multi-tab safety.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
