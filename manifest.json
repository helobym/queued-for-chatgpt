{
  "manifest_version": 3,
  "name": "Queued for ChatGPT",
  "short_name": "Queued for ChatGPT",
  "version": "1.2.10",
  "description": "Lightweight ChatGPT queues and workflows with accessible, adjustable desktop notification alerts.",
  "permissions": [
    "storage",
    "notifications",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-queue-panel": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Open or close the Queued for ChatGPT panel"
    }
  }
}
