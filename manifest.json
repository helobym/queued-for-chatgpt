{
  "manifest_version": 3,
  "name": "Queued for ChatGPT",
  "short_name": "Queued for ChatGPT",
  "version": "1.2.1",
  "description": "Lightweight ChatGPT prompt queues and reusable multi-step workflows, with multi-tab coordination and a draggable panel.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
